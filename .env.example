# Postgres connection. Local: postgres://postgres:postgres@localhost:5432/taskx
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432), add ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskx

HOST=127.0.0.1
PORT=8080

# Browser origins allowed to call the API (comma separated). The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts: "on" (default) = people sign up and sign in, each account has its own workspace.
# "off" = single-business mode with no sign-in (only for a private machine).
AUTH=on

# With accounts off, everything is stored in this workspace. With accounts on, the first
# account created adopts it, so data from single-business mode carries over.
WORKSPACE_ID=default

# Where timer screenshots are written (inside this repo by default, git-ignored).
SCREENSHOT_DIR=./storage/screenshots

RUST_LOG=taskx_backend=info,tower_http=info
